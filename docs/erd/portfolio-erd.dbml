Table Profile {
  id int [pk, note: 'singleton row, id fixed at 1']
  title string
  headline string
  subtitle string
}

Table User {
  id int [pk, note: 'singleton row, id fixed at 1']
  username string
  passwordHash string [note: 'ASP.NET Core Identity PasswordHasher output']
}

Table Skill {
  id guid [pk]
  name string
  skillCategory SkillCategory
}

Table Experience {
  id guid [pk]
  jobTitle string
  employer string
  startDate date
  endDate date [null, note: 'null while the role is ongoing']
  description string
}

Table Qualification {
  id guid [pk]
  name string
  institution string
  startDate date
  endDate date [null, note: 'null while in progress']
  nqfLevel NqfLevel
}

Table Project {
  id guid [pk]
  name string
  url string
}

Table Certification {
  id guid [pk]
  name string
  url string
  issuingOrganization string
  issueDate date
}

Table ExperienceSkill {
  experienceId guid [ref: > Experience.id]
  skillId guid [ref: > Skill.id]

  indexes {
    (experienceId, skillId) [pk]
  }
}

Table QualificationSkill {
  qualificationId guid [ref: > Qualification.id]
  skillId guid [ref: > Skill.id]

  indexes {
    (qualificationId, skillId) [pk]
  }
}

Table ProjectSkill {
  id guid [pk]
  projectId guid [ref: > Project.id]
  skillId guid [ref: > Skill.id]
}

Table CertificationSkill {
  id guid [pk]
  certificationId guid [ref: > Certification.id]
  skillId guid [ref: > Skill.id]
}

Enum SkillCategory {
  LanguagesAndBackend
  SystemsAndData
  Platform
  TestingAndReliability
  CloudAndDevOps
}

Enum NqfLevel {
  Grade9 [note: '1 — GETC / ABET Level 4']
  Grade10 [note: '2 — NCV Level 2']
  Grade11 [note: '3 — NCV Level 3']
  Grade12 [note: '4 — Matric / NCV Level 4']
  HigherCertificate [note: '5']
  Diploma [note: '6 — Advanced Certificate']
  BachelorsDegree [note: '7 — Advanced Diploma']
  HonoursDegree [note: '8 — Postgraduate Diploma']
  MastersDegree [note: '9']
  DoctoralDegree [note: '10']
}

Table Session {
  id guid [pk]
  userId int [ref: > User.id]
  refreshTokenHash string [note: 'current token, HMAC-SHA256 hashed']
  expiresAt datetime
  revokedAt datetime [note: 'null while active']
  rotatedAt datetime [note: 'last refresh']
}

Table RefreshToken {
  id guid [pk]
  sessionId guid [ref: > Session.id]
  refreshTokenHash string [note: 'a previously-used token for this session']
  rotatedAt datetime
}
